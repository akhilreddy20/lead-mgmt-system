PORT=5000
MONGODB_URI=mongodb://localhost:27017/lead_mgmt
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Shared secret for POST /api/leads/api-source (send as X-API-Key)
LEAD_API_KEY=change_me
# Where payment proofs are stored (never served publicly)
UPLOAD_DIR=uploads
